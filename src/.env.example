# KI Claude <KI-18>
# Copy this file to ".env" (same folder) and fill in your real Cloud database URL.
# The .env file itself is gitignored, so credentials are never committed.
#
# If DATABASE_URL is left unset, the API falls back to the local SQLite file (RATBASE.db).
#
# Examples:
#   Supabase / Railway (PostgreSQL):
#     DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
#   PlanetScale (MySQL):
#     DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?ssl_ca=/etc/ssl/certs/ca-certificates.crt
#
# NOTE: install the matching driver for your DB, e.g.
#   pip install "psycopg2-binary"   # PostgreSQL
#   pip install "pymysql"           # MySQL / PlanetScale

DATABASE_URL=
